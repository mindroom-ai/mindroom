      "name": "question beats work",
      "now": 1000,
      "status": {
        "pending_question": true,
        "has_background_job": true
      },
      "expected": {
        "workflow": "needs_you",
        "why": "question"
      }
    },
    {
      "name": "streaming reply",
      "now": 1000,
      "status": {
        "is_streaming": true
      },
      "expected": {
        "workflow": "working"
      }
