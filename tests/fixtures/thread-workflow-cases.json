{
  "version": 1,
  "cases": [
    {
      "name": "idle",
      "now": 1000,
      "status": {},
      "expected": {
        "workflow": "needs_you",
        "why": "your_turn"
      }
    },
    {
      "name": "resolved",
      "now": 1000,
      "status": {
        "is_resolved": true
      },
      "expected": {
        "workflow": "done"
      }
    },
    {
      "name": "resolved beats snooze, work and schedule",
      "now": 1000,
      "status": {
        "is_resolved": true,
        "snoozed_until_ts": 2000,
        "is_streaming": true,
        "has_background_job": true,
        "scheduled_task_count": 1
      },
      "expected": {
        "workflow": "done"
      }
    },
    {
      "name": "resolved hides a background approval",
      "now": 1000,
      "status": {
        "is_resolved": true,
        "has_background_approval": true
      },
      "expected": {
        "workflow": "done"
      }
    },
    {
      "name": "approval asked after the resolve",
      "now": 1000,
      "status": {
        "is_resolved": true,
        "pending_approval": true
      },
      "expected": {
        "workflow": "needs_you",
        "why": "approval"
      }
    },
    {
      "name": "question asked after the resolve",
      "now": 1000,
      "status": {
        "is_resolved": true,
        "pending_question": true
      },
      "expected": {
        "workflow": "needs_you",
        "why": "question"
      }
    },
    {
      "name": "active snooze",
      "now": 1000,
      "status": {
        "snoozed_until_ts": 2000
      },
      "expected": {
        "workflow": "later",
        "back_at": 2000
      }
    },
    {
      "name": "snooze ending now",
      "now": 1000,
      "status": {
        "snoozed_until_ts": 1000
      },
      "expected": {
        "workflow": "needs_you",
        "why": "your_turn"
      }
    },
    {
      "name": "expired snooze",
      "now": 1000,
      "status": {
        "snoozed_until_ts": 999
      },
      "expected": {
        "workflow": "needs_you",
        "why": "your_turn"
