        "back_at": 5000
      }
    },
    {
      "name": "scheduled without a known time",
      "now": 1000,
      "status": {
        "scheduled_task_count": 2
      },
      "expected": {
        "workflow": "later"
      }
    },
    {
      "name": "expired snooze with a schedule",
      "now": 1000,
      "status": {
        "snoozed_until_ts": 999,
        "scheduled_task_count": 1,
        "next_scheduled_ts": 5000
      },
      "expected": {
        "workflow": "later",
        "back_at": 5000
      }
