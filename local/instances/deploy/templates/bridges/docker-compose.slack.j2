services:
  slack:
    container_name: {{ instance_name }}-slack-bridge
    image: {{ image }}
    networks:
      - {{ instance_name }}_mindroom-network
      - mynetwork
    ports:
      - "127.0.0.1:{{ port }}:29317"
    restart: unless-stopped
    volumes:
      - {{ data_dir }}/data:/data

networks:
  {{ instance_name }}_mindroom-network:
    external: true
  mynetwork:
    external: true
