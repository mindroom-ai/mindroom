# Optional Supabase settings for the kind platform installer.
# From the repository root, copy this file to cluster/k8s/kind/.env and edit it.
# Export the values before running the kind recipes:
#   set -a
#   source cluster/k8s/kind/.env
#   set +a
# The scripts do not load this file automatically.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional installer overrides (defaults shown):
# PROVISIONER_API_KEY=kind-provisioner-key
# INSTANCE_BASE_DOMAIN=local
# INSTANCE_STORAGE_CLASS_NAME=standard
# INSTANCE_MINDROOM_IMAGE=ghcr.io/mindroom-ai/mindroom:latest
# INSTANCE_MINDROOM_IMAGE_PULL_POLICY=IfNotPresent
# INSTANCE_SYNAPSE_IMAGE=matrixdotorg/synapse:latest
# INSTANCE_SYNAPSE_IMAGE_PULL_POLICY=IfNotPresent
# The image loader separately reads SYNAPSE_IMAGE when pulling/loading Synapse.
# Set it to match INSTANCE_SYNAPSE_IMAGE if overriding that image.
