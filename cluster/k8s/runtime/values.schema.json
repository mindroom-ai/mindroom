{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "agentRepositories": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "organization": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        },
        "brokerUrl": {
          "type": "string"
        },
        "brokerTokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
