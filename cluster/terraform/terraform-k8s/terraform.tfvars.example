# ===========================================
# MindRoom K8s Infrastructure Configuration
# ===========================================
# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to version control!
# ===========================================

# Hetzner Cloud
hcloud_token = "YOUR_HETZNER_API_TOKEN"

# DNS Management (Porkbun)
porkbun_api_key    = "YOUR_PORKBUN_API_KEY"
porkbun_secret_key = "YOUR_PORKBUN_SECRET_KEY"

# Domain and Environment
# Replace example.test with your Porkbun DNS zone.
# environment controls naming; it does not add a prefix to domain.
domain      = "staging.example.test"
root_domain = "example.test"
environment = "staging"  # For production, also set domain to the root domain.

# Enable the platform Helm release (defaults to false when omitted).
deploy_platform = true

# Provisioner authentication and fallback root for stable per-instance secrets.
# Use a strong, unique value and configure system API clients with the same key.
# Keep this value stable for existing tenants.
provisioner_api_key = "REPLACE_WITH_A_STRONG_UNIQUE_SECRET"

# Supabase
supabase_url         = "https://YOUR_PROJECT.supabase.co"
supabase_anon_key    = "eyJ..."
supabase_service_key = "eyJ..."

# Stripe
stripe_publishable_key = "pk_test_..."
stripe_secret_key      = "sk_test_..."
stripe_webhook_secret  = "whsec_..."

# OAuth Providers (Optional)
# Leave empty to disable OAuth providers
# Google OAuth - Get from https://console.cloud.google.com/
google_oauth_client_id     = ""
google_oauth_client_secret = ""

# GitHub OAuth - Get from https://github.com/settings/developers
github_oauth_client_id     = ""
github_oauth_client_secret = ""

# Docker Registry
registry  = "ghcr.io/mindroom-ai"
image_tag   = "latest"

# Server Configuration
server_type = "cpx31"  # 4 vCPU, 8GB RAM
location    = "fsn1"   # Falkenstein, Germany

# Cluster Configuration
cluster_name = "mindroom-k8s"

# Monitoring
deploy_monitoring       = true
monitoring_release_name = "monitoring"
monitoring_namespace    = "monitoring"
monitoring_chart_version = "75.15.1"
