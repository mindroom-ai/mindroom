        "GH_TOKEN": "mindroom-brokered",
        "GITHUB_TOKEN": "mindroom-brokered"
      },
      "rules": [
        {
          "host": "api.github.com",
          "path_prefix": "/",
          "port": null
        },
        {
          "host": "uploads.github.com",
          "path_prefix": "/",
          "port": null
        },
        {
          "host": "github.com",
          "path_prefix": "/",
          "port": null
        }
